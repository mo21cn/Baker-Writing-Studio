{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Baker Writing Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/read2md-studio/assets" },
        { "path": "$APPDATA/read2md-studio/assets/**" }
      ]
    },
    {
      "identifier": "fs:allow-app-read-recursive",
      "allow": [
        { "path": "$APPDATA/read2md-studio/assets" },
        { "path": "$APPDATA/read2md-studio/assets/**" }
      ]
    },
    {
      "identifier": "fs:allow-app-write-recursive",
      "allow": [
        { "path": "$APPDATA/read2md-studio/assets" },
        { "path": "$APPDATA/read2md-studio/assets/**" }
      ]
    },
    {
      "identifier": "fs:allow-app-meta-recursive",
      "allow": [
        { "path": "$APPDATA/read2md-studio/assets" },
        { "path": "$APPDATA/read2md-studio/assets/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/read2md-studio/assets" },
        { "path": "$APPDATA/read2md-studio/assets/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/read2md-studio/assets/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/read2md-studio/assets/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/read2md-studio/assets/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/read2md-studio/assets" },
        { "path": "$APPDATA/read2md-studio/assets/**" }
      ]
    },
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-text"
  ]
}
